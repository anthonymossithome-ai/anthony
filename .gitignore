Aqui está o site completo em um único arquivo HTML — copie, cole em `index.html` e abra no navegador.

```html
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SOMM — Revista de Moda, Estilo e Afins</title>
<meta name="description" content="SOMM é um diário editorial sobre moda, forma e estilo: looks, tendências, alfaiataria e entrevistas em português.">
<meta property="og:title" content="SOMM — Revista de Moda, Estilo e Afins">
<meta property="og:description" content="Looks, tendências, alfaiataria e entrevistas. Um diário editorial de moda em português.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Hanken+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
tailwind.config = {
  theme: {
    extend: {
      colors: {
        ink: '#1a1817',
        paper: '#f5f1ea',
        'paper-soft': '#efe9df',
        accent: '#9c4a2e',
        muted: '#8a8378',
      },
      fontFamily: {
        serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
        sans: ['"Hanken Grotesk"', 'system-ui', 'sans-serif'],
      },
    },
  },
};
</script>
<style>
  html { scroll-behavior: smooth; }
  body { background:#f5f1ea; color:#1a1817; }
  @keyframes fadeUp { from { opacity:0; transform:translateY(24px); } to { opacity:1; transform:none; } }
  .reveal { opacity:0; }
  .reveal.in { animation: fadeUp 1s cubic-bezier(.2,.6,.2,1) both; }
  .look img { transition: transform .8s cubic-bezier(.2,.6,.2,1), filter .5s ease; }
  .look:hover img { transform: scale(1.04); filter: saturate(1.05); }
</style>
</head>
<body class="font-sans antialiased selection:bg-accent selection:text-paper">

<!-- ================= TOPO ================= -->
<div class="flex items-center justify-between border-b border-ink/10 px-6 py-2.5 text-[10px] uppercase tracking-[0.3em] text-ink/50 md:px-10">
  <span>Desde 2019 — São Paulo · Lisboa</span>
  <span class="hidden sm:block">Outono / Inverno 2026</span>
  <span>Nº 24</span>
</div>

<!-- ================= NAV ================= -->
<header class="sticky top-0 z-50 border-b border-ink/10 bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-[1440px] items-center justify-between px-6 py-5 md:px-10">
    <a href="#inicio" class="font-serif text-2xl font-semibold tracking-tight">SOMM</a>
    <nav class="hidden items-center gap-9 text-[12px] uppercase tracking-[0.2em] text-ink/70 md:flex">
      <a href="#inicio" class="transition-colors hover:text-accent">Início</a>
      <a href="#looks" class="transition-colors hover:text-accent">Looks</a>
      <a href="#journal" class="transition-colors hover:text-accent">Journal</a>
      <a href="#sobre" class="transition-colors hover:text-accent">Sobre</a>
      <a href="#contato" class="transition-colors hover:text-accent">Contato</a>
    </nav>
    <button id="btnMenu" class="text-[11px] uppercase tracking-[0.2em] md:hidden">Menu</button>
  </div>
  <div id="menuMobile" class="hidden border-t border-ink/10 px-6 pb-6 pt-2 md:hidden">
    <a href="#inicio" class="block py-2 text-sm uppercase tracking-[0.2em] text-ink/70">Início</a>
    <a href="#looks" class="block py-2 text-sm uppercase tracking-[0.2em] text-ink/70">Looks</a>
    <a href="#journal" class="block py-2 text-sm uppercase tracking-[0.2em] text-ink/70">Journal</a>
    <a href="#sobre" class="block py-2 text-sm uppercase tracking-[0.2em] text-ink/70">Sobre</a>
    <a href="#contato" class="block py-2 text-sm uppercase tracking-[0.2em] text-ink/70">Contato</a>
  </div>
</header>

<!-- ================= HERO ================= -->
<section id="inicio" class="relative">
  <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1920&q=80"
       alt="Editorial de moda em tons neutros"
       class="h-[78vh] w-full object-cover md:h-[86vh]">
  <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent"></div>
  <div class="absolute inset-0 flex items-end">
    <div class="mx-auto w-full max-w-[1440px] px-6 pb-12 md:px-10 md:pb-20">
      <div class="reveal max-w-[46ch]">
        <p class="mb-4 text-[11px] font-medium uppercase tracking-[0.35em] text-paper/80">Editorial · Nº 24</p>
        <h1 class="font-serif text-5xl font-medium leading-[1.02] text-paper md:text-7xl">O Silêncio<br>da Forma</h1>
        <p class="mt-6 max-w-[46ch] text-base leading-relaxed text-paper/80">
          Uma edição sobre a quietude que habita o vestuário — tecidos que respiram,
          cortes que dizem o suficiente e nada além.
        </p>
        <a href="#journal" class="mt-8 inline-block border border-paper/70 px-6 py-3 text-[11px] uppercase tracking-[0.25em] text-paper transition-colors hover:bg-paper hover:text-ink">
          Ler a edição
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ================= DESTAQUES ================= -->
<section class="mx-auto max-w-[1440px] px-6 py-20 md:px-10 md:py-28">
  <div class="mb-12 flex flex-wrap items-end justify-between gap-4">
    <h2 class="reveal font-serif text-3xl font-medium md:text-5xl">Em Destaque</h2>
    <span class="text-[11px] uppercase tracking-[0.25em] text-muted">Histórias selecionadas</span>
  </div>

  <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
    <article class="reveal look md:col-span-7">
      <div class="overflow-hidden rounded-sm bg-paper-soft">
        <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1400&q=80"
             alt="Alfaiataria em lã sob luz natural" class="aspect-[4/3] w-full object-cover">
      </div>
      <span class="mt-5 block text-[11px] uppercase tracking-[0.25em] text-accent">Entrevista</span>
      <h3 class="mt-2 font-serif text-2xl font-medium md:text-4xl">A Costura Lenta</h3>
      <p class="mt-3 max-w-[52ch] text-sm leading-relaxed text-ink/65">
        Dentro de um ateliê onde um único casaco leva quarenta e um dias — e nenhuma
        costura corre exatamente reta.
      </p>
    </article>

    <div class="md:col-span-5 md:pl-8">
      <article class="reveal look">
        <div class="overflow-hidden rounded-sm bg-paper-soft">
          <img src="https://images.unsplash.com/photo-1519744792095-2f2205e87b6f?auto=format&fit=crop&w=1000&q=80"
               alt="Textura de lã tricotada à mão" class="aspect-[5/4] w-full object-cover">
        </div>
        <span class="mt-5 block text-[11px] uppercase tracking-[0.25em] text-accent">Matéria</span>
        <h3 class="mt-2 font-serif text-2xl font-medium md:text-3xl">A Lã que Fala</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink/65">
          Três ateliês brasileiros redefinem o gesto artesanal a cada ponto.
        </p>
      </article>

      <article class="reveal mt-10 border-t border-ink/10 pt-6">
        <span class="text-[11px] uppercase tracking-[0.25em] text-accent">Coluna</span>
        <h3 class="mt-2 font-serif text-xl font-medium">O Retorno do Linho</h3>
        <p class="mt-2 text-sm text-ink/60">Por que o tecido mais antigo do armário voltou a ser o mais desejado.</p>
      </article>

      <article class="reveal mt-8 border-t border-ink/10 pt-6">
        <span class="text-[11px] uppercase tracking-[0.25em] text-accent">Tendência</span>
        <h3 class="mt-2 font-serif text-xl font-medium">Neutros que Não São Neutros</h3>
        <p class="mt-2 text-sm text-ink/60">Aveia, argila, osso: a paleta que substituiu o preto total.</p>
      </article>
    </div>
  </div>
</section>

<!-- ================= LOOKS ================= -->
<section id="looks" class="bg-ink">
  <div class="mx-auto max-w-[1440px] px-6 py-20 md:px-10 md:py-28">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-4">
      <h2 class="reveal font-serif text-3xl font-medium text-paper md:text-5xl">Looks do Momento</h2>
      <span class="text-[11px] uppercase tracking-[0.25em] text-paper/50">Galeria · Temporada 07</span>
    </div>

    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
      <figure class="reveal look">
        <div class="overflow-hidden rounded-sm bg-paper-soft">
          <img src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=800&q=80"
               alt="Look em tons de ferrugem e creme" class="aspect-[3/4] w-full object-cover">
        </div>
        <figcaption class="mt-3">
          <p class="font-serif text-lg font-medium text-paper">Ferrugem &amp; Creme</p>
          <p class="text-[11px] uppercase tracking-[0.2em] text-paper/45">Look 01 · Lã crua</p>
        </figcaption>
      </figure>

      <figure class="reveal look md:mt-12">
        <div class="overflow-hidden rounded-sm bg-paper-soft">
          <img src="https://images.unsplash.com/photo-1495121605193-b116b5b9c5fe?auto=format&fit=crop&w=800&q=80"
               alt="Alfaiataria monocromática grafite" class="aspect-[3/4] w-full object-cover">
        </div>
        <figcaption class="mt-3">
          <p class="font-serif text-lg font-medium text-paper">Grafite</p>
          <p class="text-[11px] uppercase tracking-[0.2em] text-paper/45">Look 02 · Alfaiataria</p>
        </figcaption>
      </figure>

      <figure class="reveal look">
        <div class="overflow-hidden rounded-sm bg-paper-soft">
          <img src="https://images.unsplash.com/photo-1485462537746-965f33f7f6a7?auto=format&fit=crop&w=800&q=80"
               alt="Camadas de tricô em tom aveia" class="aspect-[3/4] w-full object-cover">
        </div>
        <figcaption class="mt-3">
          <p class="font-serif text-lg font-medium text-paper">Aveia</p>
          <p class="text-[11px] uppercase tracking-[0.2em] text-paper/45">Look 03 · Camadas</p>
        </figcaption>
      </figure>

      <figure class="reveal look md:mt-12">
        <div class="overflow-hidden rounded-sm bg-paper-soft">
          <img src="https://images.unsplash.com/photo-1502716119720-b23a93e5fe1b?auto=format&fit=crop&w=800&q=80"
               alt="Vestido de seda drapeado em terracota" class="aspect-[3/4] w-full object-cover">
        </div>
        <figcaption class="mt-3">
          <p class="font-serif text-lg font-medium text-paper">Terracota</p>
          <p class="text-[11px] uppercase tracking-[0.2em] text-paper/45">Look 04 · Seda</p>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- ================= CITAÇÃO ================= -->
<section class="mx-auto max-w-4xl px-6 py-24 text-center md:py-32">
  <p class="reveal font-serif text-3xl italic leading-tight md:text-5xl">
    “A moda é a única arte dentro da qual se pode viver.”
  </p>
  <p class="mt-8 text-[11px] uppercase tracking-[0.4em] text-muted">— Carta da editora</p>
</section>

<!-- ================= JOURNAL ================= -->
<section id="journal" class="border-t border-ink/10">
  <div class="mx-auto max-w-[1440px] px-6 py-20 md:px-10 md:py-28">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-4">
      <h2 class="reveal font-serif text-3xl font-medium md:text-5xl">Journal</h2>
      <span class="text-[11px] uppercase tracking-[0.25em] text-muted">Leituras recentes</span>
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-3">
      <article class="reveal look">
        <div class="overflow-hidden rounded-sm bg-paper-soft">
          <img src="https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?auto=format&fit=crop&w=900&q=80"
               alt="Peças dobradas em paleta neutra" class="aspect-[4/3] w-full object-cover">
        </div>
        <p class="mt-4 text-[11px] uppercase tracking-[0.25em] text-accent">Guia</p>
        <h3 class="mt-2 font-serif text-2xl font-medium">Como montar um guarda-roupa essencial</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink/60">Doze peças, uma década. O método de quem compra pouco e veste sempre.</p>
        <p class="mt-3 text-[11px] uppercase tracking-[0.2em] text-muted">08 min de leitura</p>
      </article>

      <article class="reveal look">
        <div class="overflow-hidden rounded-sm bg-paper-soft">
          <img src="https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=900&q=80"
               alt="Bastidores de desfile" class="aspect-[4/3] w-full object-cover">
        </div>
        <p class="mt-4 text-[11px] uppercase tracking-[0.25em] text-accent">Semana</p>
        <h3 class="mt-2 font-serif text-2xl font-medium">Bastidores da semana de moda</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink/60">O que aconteceu longe da passarela — e por que importa mais.</p>
        <p class="mt-3 text-[11px] uppercase tracking-[0.2em] text-muted">05 min de leitura</p>
      </article>

      <article class="reveal look">
        <div class="overflow-hidden rounded-sm bg-paper-soft">
          <img src="https://images.unsplash.com/photo-1528701800484-905dfd6bfc4b?auto=format&fit=crop&w=900&q=80"
               alt="Detalhe de costura em couro" class="aspect-[4/3] w-full object-cover">
        </div>
        <p class="mt-4 text-[11px] uppercase tracking-[0.25em] text-accent">Ofício</p>
        <h3 class="mt-2 font-serif text-2xl font-medium">O ofício do couro no Brasil</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink/60">De Franca a Belo Jardim: as mãos que ainda cortam sem molde.</p>
        <p class="mt-3 text-[11px] uppercase tracking-[0.2em] text-muted">11 min de leitura</p>
      </article>
    </div>
  </div>
</section>

<!-- ================= SOBRE ================= -->
<section id="sobre" class="border-t border-ink/10 bg-paper-soft">
  <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-12 px-6 py-20 md:grid-cols-12 md:px-10 md:py-28">
    <div class="reveal md:col-span-5">
      <img src="https://images.unsplash.com/photo-1487222477894-8943e31ef7b2?auto=format&fit=crop&w=1000&q=80"
           alt="Ateliê de costura" class="aspect-[4/5] w-full rounded-sm object-cover">
    </div>
    <div class="reveal md:col-span-6 md:col-start-7 md:self-center">
      <p class="text-[11px] uppercase tracking-[0.3em] text-accent">Sobre a SOMM</p>
      <h2 class="mt-4 font-serif text-3xl font-medium leading-tight md:text-5xl">Um diário sobre moda, forma e afetos</h2>
      <p class="mt-6 text-sm leading-relaxed text-ink/70">
        A SOMM é uma revista editorial independente publicada em português. Escrevemos sobre
        alfaiataria, tecidos, ofício e as pessoas que vestem o que fazem — com o tempo que
        cada história pede.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-ink/70">
        Sem pressa, sem tendência descartável. Publicamos oito edições por ano, impressas em
        tiragem limitada e lidas em qualquer lugar.
      </p>
      <dl class="mt-10 grid grid-cols-3 gap-6 border-t border-ink/15 pt-6">
        <div><dt class="text-[10px] uppercase tracking-[0.25em] text-muted">Edições</dt><dd class="mt-1 font-serif text-3xl">24</dd></div>
        <div><dt class="text-[10px] uppercase tracking-[0.25em] text-muted">Colaboradores</dt><dd class="mt-1 font-serif text-3xl">62</dd></div>
        <div><dt class="text-[10px] uppercase tracking-[0.25em] text-muted">Desde</dt><dd class="mt-1 font-serif text-3xl">2019</dd></div>
      </dl>
    </div>
  </div>
</section>

<!-- ================= CONTATO ================= -->
<section id="contato" class="border-t border-ink/10">
  <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-12 px-6 py-20 md:grid-cols-12 md:px-10 md:py-28">
    <div class="reveal md:col-span-5">
      <h2 class="font-serif text-3xl font-medium md:text-5xl">Contato</h2>
      <p class="mt-5 max-w-[42ch] text-sm leading-relaxed text-ink/65">
        Pautas, parcerias, imprensa ou simplesmente uma boa história de ateliê.
        Respondemos toda correspondência.
      </p>
      <ul class="mt-8 space-y-3 text-sm text-ink/70">
        <li><span class="text-[10px] uppercase tracking-[0.25em] text-muted">E-mail</span><br>ola@somm.jor.br</li>
        <li><span class="text-[10px] uppercase tracking-[0.25em] text-muted">Redação</span><br>Rua Aspicuelta, 214 — Vila Madalena, São Paulo</li>
        <li><span class="text-[10px] uppercase tracking-[0.25em] text-muted">Social</span><br>@somm.editorial</li>
      </ul>
    </div>

    <form class="reveal md:col-span-6 md:col-start-7" onsubmit="event.preventDefault(); this.reset(); document.getElementById('okMsg').classList.remove('hidden');">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <label class="block">
          <span class="text-[10px] uppercase tracking-[0.25em] text-muted">Nome</span>
          <input required type="text" class="mt-2 w-full border-b border-ink/25 bg-transparent py-2 text-sm outline-none focus:border-accent">
        </label>
        <label class="block">
          <span class="text-[10px] uppercase tracking-[0.25em] text-muted">E-mail</span>
          <input required type="email" class="mt-2 w-full border-b border-ink/25 bg-transparent py-2 text-sm outline-none focus:border-accent">
        </label>
      </div>
      <label class="mt-6 block">
        <span class="text-[10px] uppercase tracking-[0.25em] text-muted">Assunto</span>
        <input type="text" class="mt-2 w-full border-b border-ink/25 bg-transparent py-2 text-sm outline-none focus:border-accent">
      </label>
      <label class="mt-6 block">
        <span class="text-[10px] uppercase tracking-[0.25em] text-muted">Mensagem</span>
        <textarea required rows="4" class="mt-2 w-full resize-none border-b border-ink/25 bg-transparent py-2 text-sm outline-none focus:border-accent"></textarea>
      </label>
      <button type="submit" class="mt-8 border border-ink px-7 py-3 text-[11px] uppercase tracking-[0.25em] transition-colors hover:bg-ink hover:text-paper">
        Enviar mensagem
      </button>
      <p id="okMsg" class="mt-4 hidden text-sm text-accent">Mensagem enviada. Obrigado pelo contato.</p>
    </form>
  </div>
</section>

<!-- ================= FOOTER ================= -->
<footer class="border-t border-ink/15 bg-ink text-paper">
  <div class="mx-auto max-w-[1440px] px-6 py-16 md:px-10 md:py-20">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <span class="font-serif text-3xl font-semibold">SOMM</span>
        <p class="mt-4 max-w-[40ch] text-sm leading-relaxed text-paper/60">
          Um diário editorial sobre moda, forma e afetos. Publicado em português, feito com calma.
        </p>
      </div>
      <div class="md:col-span-2 md:col-start-7">
        <p class="text-[10px] uppercase tracking-[0.25em] text-paper/45">Navegar</p>
        <ul class="mt-4 space-y-2 text-sm text-paper/75">
          <li><a href="#inicio" class="hover:text-accent">Início</a></li>
          <li><a href="#looks" class="hover:text-accent">Looks</a></li>
          <li><a href="#journal" class="hover:text-accent">Journal</a></li>
          <li><a href="#sobre" class="hover:text-accent">Sobre</a></li>
        </ul>
      </div>
      <div class="md:col-span-2">
        <p class="text-[10px] uppercase tracking-[0.25em] text-paper/45">Estúdio</p>
        <ul class="mt-4 space-y-2 text-sm text-paper/75">
          <li><a href="#contato" class="hover:text-accent">Imprensa</a></li>
          <li><a href="#contato" class="hover:text-accent">Colaboradores</a></li>
          <li><a href="#contato" class="hover:text-accent">Contato</a></li>
        </ul>
      </div>
      <div class="md:col-span-3">
        <p class="text-[10px] uppercase tracking-[0.25em] text-paper/45">A carta</p>
        <p class="mt-4 text-sm text-paper/60">Uma edição, duas vezes por mês.</p>
        <form class="mt-4 flex border-b border-paper/30" onsubmit="event.preventDefault(); this.reset();">
          <input type="email" required placeholder="seu@email.com"
                 class="w-full bg-transparent py-2 text-sm placeholder:text-paper/35 focus:outline-none">
          <button class="pl-3 text-[11px] uppercase tracking-[0.2em] hover:text-accent">Assinar</button>
        </form>
      </div>
    </div>
    <div class="mt-14 flex flex-col gap-2 border-t border-paper/15 pt-6 text-[10px] uppercase tracking-[0.25em] text-paper/40 md:flex-row md:justify-between">
      <span>© 2026 SOMM Editorial. Todos os direitos reservados.</span>
      <span>Feito com calma, no Brasil.</span>
    </div>
  </div>
</footer>

<script>
  // Menu mobile
  document.getElementById('btnMenu').addEventListener('click', () => {
    document.getElementById('menuMobile').classList.toggle('hidden');
  });

  // Revelação suave no scroll
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) {
        e.target.style.animationDelay = (i * 80) + 'ms';
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>
</body>
</html>
```

Pronto — é um arquivo único, editorial, em português, com hero, destaques, galeria de looks, journal, sobre, contato e rodapé; se quiser, posso montar isso direto no seu projeto como páginas separadas.
